<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты без внешних пакетов: свой мини-раннер (TestRunner.cs).
    Запуск: dotnet run (из папки core/tests/Nerv.Core.Tests)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Nerv.Core/Nerv.Core.csproj" />
  </ItemGroup>

</Project>
